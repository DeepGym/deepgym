{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!**/.next", "!**/.source", "!**/out", "!**/node_modules", "!next-env.d.ts"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double" } },
  "css": { "parser": { "tailwindDirectives": true }, "formatter": { "quoteStyle": "single" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": { "rules": { "preset": "recommended" } }
}
