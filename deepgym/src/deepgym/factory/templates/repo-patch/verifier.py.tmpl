"""Verifier for $name: apply the model's diff to the fixture repo, then test the result.

The judge never imports or runs the solution itself. apply_patch() edits the fixture
files as text in memory (a patch can only change files listed in REPO_FILES), and
load_files() imports the patched code in an isolated process, where every call
crosses the boundary as plain data. Every case is reported with a reason. A diff
that doesn't apply scores 0 as the model's fault; a bug in this file ends the run as
a verifier error (no reward) instead of a silent 0.

To adapt it: put your repo's files in repo/ (flat: support files are placed next to
this file by name), list them in metadata.json support_files and REPO_FILES, show
them in task.md, rewrite expected() and edit variants.py.
"""

import os

from deepgym_solution import LaunchError, apply_patch, load_files, solution_source
from variants import generate

REPO_FILES = ('runs.py',)
"""The fixture files a patch may edit, by the names the diff uses."""

ENTRY = 'runs.py'
"""The module the tests import."""

FUNCTION = 'longest_run'

SEED = 0
"""Fixed, so every run scores the same cases (the QA gate checks determinism)."""

RANDOM_CASES = 40


def expected(values):
    """The judge's own answer. Keep it simple and independent of the reference."""
    best = 0
    for start in range(len(values)):
        end = start + 1
        while end < len(values) and values[end] > values[end - 1]:
            end += 1
        best = max(best, end - start)
    return best


def fixture():
    """The unpatched repo files, read from the judge's own directory."""
    here = os.path.dirname(os.path.abspath(__file__))
    files = {}
    for name in REPO_FILES:
        with open(os.path.join(here, name), encoding='utf-8') as handle:
            files[name] = handle.read()
    return files


def run_case(index, values, function):
    """Call the patched code on one input and report the outcome with a reason."""
    want = expected(values)
    case = {'id': f'case_{index}', 'input_summary': repr(values)[:200]}
    case['expected_summary'] = repr(want)[:200]
    try:
        got = function(values)
    except LaunchError:
        raise  # the machine couldn't start it: a verifier error, never the solution's 0
    except Exception as exc:  # the patched code raised or timed out on this input
        return {**case, 'passed': False, 'error': f'raised {type(exc).__name__}: {exc}'[:300]}
    passed = type(got) is type(want) and got == want
    reason = {} if passed else {'error': f'expected {want!r}, got {got!r}'[:300]}
    return {**case, 'passed': passed, 'actual_summary': repr(got)[:200], **reason}


def result(cases, problem=None):
    """Full marks only when every case passes; partial credit otherwise."""
    passed = sum(case['passed'] for case in cases)
    return {
        'score': passed / len(cases) if cases else 0.0,
        'passed': bool(cases) and passed == len(cases),
        'details': problem or f'{passed}/{len(cases)} cases passed',
        'cases': cases,
        'seed': SEED,
    }


def verify(solution_path, test_cases_path=None):
    """Apply the diff at *solution_path* and score the patched repo on every case."""
    try:
        files = apply_patch(solution_source(solution_path), fixture())
    except ValueError as exc:  # malformed or not applicable: the model's fault, a real 0
        return {**result([], f'patch does not apply: {exc}'), 'error_type': 'patch_apply_failed'}
    try:
        function = getattr(load_files(files, ENTRY), FUNCTION, None)
    except LaunchError:
        raise  # the machine couldn't start it: a verifier error, never the solution's 0
    except Exception as exc:  # the patched code doesn't import or load: the model's fault
        return result([], f'patched {ENTRY} failed to load: {type(exc).__name__}: {exc}')
    if not callable(function):
        return result([], f'patched {ENTRY} has no function named {FUNCTION}')
    inputs = generate(SEED, RANDOM_CASES)
    return result([run_case(index, values, function) for index, values in enumerate(inputs)])
